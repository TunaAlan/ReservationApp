@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="auth-shell">
    <div class="card owner-panel-card auth-card auth-card--wide">
        <div class="card-body">
            <div class="text-center mb-4">
                <div class="auth-icon"><i class="bi bi-person-plus"></i></div>
                <h2 class="mb-1">Create your account</h2>
                <p class="text-muted mb-0">Book tables or list a restaurant in a couple of minutes.</p>
            </div>

            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label asp-for="Input.FirstName" class="form-label">First Name</label>
                        <input asp-for="Input.FirstName" class="form-control" placeholder="Enter your first name" />
                        <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Input.LastName" class="form-label">Last Name</label>
                        <input asp-for="Input.LastName" class="form-control" placeholder="Enter your last name" />
                        <span asp-validation-for="Input.LastName" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label">Email</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Input.Email" class="form-control" placeholder="name@example.com" />
                    </div>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label asp-for="Input.PhoneNumber" class="form-label">Phone Number</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                            <input asp-for="Input.PhoneNumber" class="form-control" placeholder="Phone number" />
                        </div>
                        <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Input.Address" class="form-label">Address</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-geo-alt"></i></span>
                            <input asp-for="Input.Address" class="form-control" placeholder="Address" />
                        </div>
                        <span asp-validation-for="Input.Address" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Role" class="form-label">Account Type</label>
                    <select asp-for="Input.Role" class="form-select">
                        <option value="client">Diner — book tables at restaurants</option>
                        <option value="restaurant">Restaurant Owner — manage a restaurant listing</option>
                    </select>
                    <div class="form-text"><i class="bi bi-info-circle"></i> Restaurant Owner accounts are linked to a listing by an admin after registration.</div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label asp-for="Input.Password" class="form-label">Password</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                            <input asp-for="Input.Password" class="form-control" type="password" placeholder="Password" />
                        </div>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Input.ConfirmPassword" class="form-label">Confirm Password</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                            <input asp-for="Input.ConfirmPassword" class="form-control" type="password" placeholder="Confirm password" />
                        </div>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <button type="submit" class="w-100 btn btn-lg btn-primary"><i class="bi bi-person-plus"></i> Register</button>
                </div>

                <div class="text-center mt-3">
                    <span class="text-muted">Already have an account?</span>
                    <a asp-page="./Login">Log in</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
