@page
@model AboutUsModel
@{
    ViewData["Title"] = "About Us";
}

<h2 class="text-center mb-4"><i class="bi bi-info-circle"></i> About Us</h2>

<div class="card owner-panel-card mb-4">
    <div class="card-body">
        <h5 class="card-title"><partial name="_BrandIcon" /> What is Reserva?</h5>
        <p class="text-muted mb-0">
            Reserva is a table reservation platform that connects restaurants with diners.
            Instead of phone calls and paper booking sheets, restaurant staff define their tables and
            seating capacity once, and the system automatically finds the best available table for
            every incoming reservation — accounting for party size and how long a table stays occupied,
            so two reservations never collide on the same seat.
        </p>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card owner-panel-card h-100">
            <div class="card-body">
                <i class="bi bi-person-gear text-primary fs-3"></i>
                <h6 class="mt-3">Admin</h6>
                <p class="text-muted small mb-0">
                    Manages the full list of restaurants, categories, and owner assignments, and can
                    pull occupancy reports across any restaurant.
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card owner-panel-card h-100">
            <div class="card-body">
                <i class="bi bi-shop text-primary fs-3"></i>
                <h6 class="mt-3">Restaurant Owner</h6>
                <p class="text-muted small mb-0">
                    Runs their own restaurant profile — tables, photos, and a live view of today's and
                    this week's bookings — without needing an admin's help.
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card owner-panel-card h-100">
            <div class="card-body">
                <i class="bi bi-person text-primary fs-3"></i>
                <h6 class="mt-3">Client</h6>
                <p class="text-muted small mb-0">
                    Browses restaurants, books a table in a couple of clicks, and gets a downloadable
                    reservation receipt with every booking's table and time.
                </p>
            </div>
        </div>
    </div>
</div>

<div class="card owner-panel-card">
    <div class="card-body text-center">
        <div class="text-muted small mb-2">Built by</div>
        <div class="fw-bold fs-5">Tuna Alan</div>
        <a class="btn btn-outline-secondary btn-sm mt-2" href="https://github.com/TunaAlan" target="_blank" rel="noopener noreferrer">
            <i class="bi bi-github"></i> GitHub
        </a>
    </div>
</div>
