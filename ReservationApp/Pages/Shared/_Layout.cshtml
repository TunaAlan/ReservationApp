<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Reserva</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ReservationApp.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        bool IsActive(string path) => Context.Request.Path.Equals(path, StringComparison.OrdinalIgnoreCase)
            || (path != "/" && Context.Request.Path.StartsWithSegments(path, StringComparison.OrdinalIgnoreCase));
        string NavClass(string path) => "nav-link" + (IsActive(path) ? " active" : "");
    }
    <header>
        <nav class="navbar navbar-expand-sm navbar-light site-navbar mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index"><partial name="_BrandIcon" /> Reserva</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">

                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="@NavClass("/")" asp-area="" asp-page="/Index"><i class="bi bi-house"></i> Home</a>
                        </li>
                        @if (User.IsInRole("admin"))
                        {
                            <li class="nav-item">
                                <a class="@NavClass("/Admin")" href="/Admin/Restaurants/Index"><i class="bi bi-building"></i> Restaurant Management</a>
                            </li>
                        }
                        else if (User.IsInRole("client"))
                        {
                            <li class="nav-item">
                                <a class="@NavClass("/Client/Restaurants")" href="/Client/Restaurants/RestaurantList"><i class="bi bi-shop-window"></i> Restaurants</a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavClass("/Client/Reservations")" href="/Client/Reservations/MyReservations"><i class="bi bi-journal-check"></i> My Reservations</a>
                            </li>
                        }
                        else if (User.IsInRole("restaurant"))
                        {
                            <li class="nav-item">
                                <a class="@NavClass("/Owner")" href="/Owner/Index"><i class="bi bi-shop"></i> Restaurant Information</a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="@NavClass("/AboutUs")" asp-area="" asp-page="/AboutUs"><i class="bi bi-info-circle"></i> About Us</a>
                        </li>
                    </ul>

                    <partial name="_LoginPartial" />

                </div>
            </div>
        </nav>
    </header>

    
    <div class="container @(ViewData["Wide"] as bool? == true ? "container-wide" : "")">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer mt-5">
        @{
            var appVersion = System.Reflection.Assembly.GetExecutingAssembly().GetName().Version?.ToString(3);
        }
        <div class="container py-3 d-flex flex-wrap justify-content-center align-items-center gap-2">
            <partial name="_BrandIcon" />
            <span>&copy; @DateTime.Now.Year Reserva</span>
            <span class="site-footer-version">v@(appVersion)</span>
        </div>
    </footer>

    <!-- Shared by every restaurant photo gallery on the page (see _RestaurantGallery.cshtml) —
         one lightbox instance, reused instead of stamping out a copy per restaurant. -->
    <div class="modal fade" id="gallery-lightbox" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content bg-dark">
                <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Close" style="z-index: 10;"></button>
                <div class="lightbox-stage">
                    <button type="button" class="lightbox-arrow lightbox-arrow-left" id="lightbox-prev" aria-label="Previous photo"><i class="bi bi-chevron-left"></i></button>
                    <img id="lightbox-img" src="" class="lightbox-img" alt="Restaurant photo" />
                    <button type="button" class="lightbox-arrow lightbox-arrow-right" id="lightbox-next" aria-label="Next photo"><i class="bi bi-chevron-right"></i></button>
                </div>
                <div class="text-center text-white pb-3" id="lightbox-counter"></div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/restaurant-gallery.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
