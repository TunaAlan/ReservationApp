@model ReservationApp.Models.RestaurantSettingsFormModel

<div class="card owner-panel-card mb-4">
    <div class="card-body">
        <h5 class="card-title"><i class="bi bi-clock"></i> Business Hours</h5>

        <div class="business-hours-table">
            @for (int i = 0; i < Model.BusinessHours.Count; i++)
            {
                <div class="business-hours-row" data-day-row>
                    <input type="hidden" asp-for="BusinessHours[i].DayOfWeek" />
                    <div class="business-hours-day">@Model.BusinessHours[i].DayOfWeek</div>
                    <div class="business-hours-time">
                        <input type="time" class="form-control" asp-for="BusinessHours[i].OpenTime" data-open-input />
                        <span class="business-hours-sep">&mdash;</span>
                        <input type="time" class="form-control" asp-for="BusinessHours[i].CloseTime" data-close-input />
                    </div>
                    <div class="form-check business-hours-closed">
                        <input type="checkbox" class="form-check-input" asp-for="BusinessHours[i].IsClosed" data-closed-checkbox />
                        <label class="form-check-label" asp-for="BusinessHours[i].IsClosed">Closed</label>
                    </div>
                </div>
            }
        </div>

        <button type="button" class="action-btn outline-btn mt-3" id="copy-monday-btn">
            <i class="bi bi-copy"></i> Copy Monday to all days
        </button>
    </div>
</div>
