@page
@model ReservationApp.Pages.Owner.Images.IndexModel
@{
    ViewData["Title"] = "My Photos";
}

<h2 class="text-center mb-4"><i class="bi bi-images"></i> Photos — @Model.Restaurant?.Name</h2>

<div class="mb-3">
    <a class="btn btn-outline-secondary" href="/Owner/Index"><i class="bi bi-arrow-left"></i> Back to Restaurant Information</a>
</div>

@if (Model.errorMessage.Length > 0)
{
    <div class="alert alert-danger" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i> @Model.errorMessage
    </div>
}

<div class="card border-light shadow-sm mb-4">
    <div class="card-body">
        <form method="post" asp-page-handler="Upload" enctype="multipart/form-data">
            <label class="form-label">Add Photos</label>
            <div class="d-flex gap-2 flex-wrap">
                <input class="form-control flex-grow-1" type="file" name="Files" multiple accept=".jpg,.jpeg,.png,.webp" style="width: auto; min-width: 240px;" />
                <button type="submit" class="btn btn-primary"><i class="bi bi-upload"></i> Upload</button>
            </div>
            <div class="form-text"><i class="bi bi-info-circle"></i> JPG, PNG, or WEBP — up to 5 MB each. Select multiple files at once.</div>
        </form>
    </div>
</div>

@if (!Model.RestaurantImages.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-images display-4"></i>
        <p class="lead mt-3">No gallery photos yet — upload some above.</p>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var image in Model.RestaurantImages)
        {
            <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="card h-100">
                    <img src="/Restaurant_Img/@image.FileName" class="card-img-top restaurant-card-img" alt="Gallery photo" />
                    <div class="card-body d-flex justify-content-between align-items-center p-2">
                        <div class="button-container">
                            <form method="post" asp-page-handler="Move" asp-route-imageId="@image.ImageId" asp-route-direction="up" class="d-inline">
                                <button type="submit" class="btn btn-outline-secondary btn-sm" title="Move earlier"><i class="bi bi-arrow-left"></i></button>
                            </form>
                            <form method="post" asp-page-handler="Move" asp-route-imageId="@image.ImageId" asp-route-direction="down" class="d-inline">
                                <button type="submit" class="btn btn-outline-secondary btn-sm" title="Move later"><i class="bi bi-arrow-right"></i></button>
                            </form>
                            <form method="post" asp-page-handler="Delete" asp-route-imageId="@image.ImageId" class="d-inline">
                                <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete"><i class="bi bi-trash-fill"></i></button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
