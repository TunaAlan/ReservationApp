@page
@model ReservationApp.Pages.Owner.IndexModel
@{
    ViewData["Title"] = "Restaurant Information";
}

<h2 class="text-center mb-4"><i class="bi bi-shop"></i> Restaurant Information</h2>

@if (Model.Restaurant == null)
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-hourglass-split display-4"></i>
        <p class="lead mt-3">No restaurant is linked to your account yet.</p>
        <p>An admin needs to assign you to a restaurant listing before you can manage it.</p>
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-md-5">
            <div class="gallery-frame">
                <partial name="_RestaurantGallery" model="Model.Restaurant" />
            </div>
        </div>
        <div class="col-md-7">
            <div class="card owner-panel-card h-100">
                <div class="card-body">
                    <h5 class="card-title">@Model.Restaurant.Name</h5>
                    <partial name="_RestaurantDetailList" model="Model.Restaurant" />
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card owner-panel-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                        <span class="badge bg-secondary" title="Tables occupied at today's busiest moment">
                            <i class="bi bi-grid-3x3-gap"></i> @Model.BookedToday / @Model.Restaurant.Tables.Count tables busy today (peak)
                        </span>
                        <div class="d-flex gap-2">
                            <a class="btn btn-outline-primary btn-sm" href="/Owner/Edit"><i class="bi bi-pencil"></i> Edit Profile</a>
                            <a class="btn btn-outline-primary btn-sm" href="/Owner/Images/Index"><i class="bi bi-images"></i> Manage Photos</a>
                            <a class="btn btn-outline-primary btn-sm" href="/Owner/Settings/Index"><i class="bi bi-sliders"></i> Settings</a>
                            <a class="btn btn-primary btn-sm" href="/Owner/Tables/Index"><i class="bi bi-grid-3x3-gap"></i> Manage Tables</a>
                        </div>
                    </div>
                    <partial name="_WeeklyOccupancyStrip" model="Model.WeeklyOccupancy" />
                </div>
            </div>
        </div>
    </div>
}
