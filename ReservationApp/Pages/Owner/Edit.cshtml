@page
@model ReservationApp.Pages.Owner.EditModel
@{
    ViewData["Title"] = "Edit Restaurant Information";
}

<div class="row">
    <div class="col-md-8 mx-auto rounded border p-3">
        <h2 class="text-center mb-5"><i class="bi bi-shop"></i> Edit Restaurant Information</h2>

        @if (Model.errorMessage.Length > 0)
        {
            <div class='alert alert-warning alert-dismissible fade show' role='alert'>
                <strong>@Model.errorMessage</strong>
                <button type='button' class='btn-close' data-bs-dismiss='alert' aria-label='Close'></button>
            </div>
        }
        else if (Model.successMessage.Length > 0)
        {
            <div class='alert alert-success alert-dismissible fade show' role='alert'>
                <strong>@Model.successMessage</strong>
                <button type='button' class='btn-close' data-bs-dismiss='alert' aria-label='Close'></button>
            </div>
        }

        <form method="post">
            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Category</label>
                <div class="col-sm-8">
                    <select class="form-select" asp-for="RestaurantDto.CategoryId" asp-items="Model.CategoryOptions">
                        <option value="">-- Select a category --</option>
                    </select>
                    <span asp-validation-for="RestaurantDto.CategoryId" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Name</label>
                <div class="col-sm-8">
                    <input class="form-control" asp-for="RestaurantDto.Name">
                    <span asp-validation-for="RestaurantDto.Name" class="text-danger"></span>
                </div>
            </div>

            <div class="location-highlight">
                <div class="location-highlight-title"><i class="bi bi-geo-alt-fill"></i> Location</div>

                <div class="row mb-3">
                    <label class="col-sm-4 col-form-label">City</label>
                    <div class="col-sm-8">
                        <select class="form-select" asp-for="RestaurantDto.CityId" asp-items="Model.CityOptions">
                            <option value="">-- Select a city --</option>
                        </select>
                        <span asp-validation-for="RestaurantDto.CityId" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-3">
                    <label class="col-sm-4 col-form-label">District</label>
                    <div class="col-sm-8">
                        <input class="form-control" asp-for="RestaurantDto.District" placeholder="e.g. Kadıköy">
                        <span asp-validation-for="RestaurantDto.District" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-3">
                    <label class="col-sm-4 col-form-label">Street Address</label>
                    <div class="col-sm-8">
                        <input class="form-control" asp-for="RestaurantDto.Address" placeholder="e.g. Bahariye Cd. No:12">
                        <span asp-validation-for="RestaurantDto.Address" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">PhoneNumber</label>
                <div class="col-sm-8">
                    <input class="form-control" asp-for="RestaurantDto.PhoneNumber">
                    <span asp-validation-for="RestaurantDto.PhoneNumber" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">AvgPrice</label>
                <div class="col-sm-8">
                    <input class="form-control" asp-for="RestaurantDto.AvgPrice">
                    <span asp-validation-for="RestaurantDto.AvgPrice" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Photos</label>
                <div class="col-sm-8 pt-2">
                    @Model.CurrentPhotoCount gallery photo(s) —
                    <a href="/Owner/Images/Index"><i class="bi bi-images"></i> Manage Photos</a>
                </div>
            </div>

            <div class="row mb-3">
                <div class="offset-sm-4 col-sm-4 d-grid">
                    <button type="submit" class="btn btn-primary">Submit</button>
                </div>
                <div class="col-sm-4 d-grid">
                    <a class="btn btn-outline-primary" href="/Owner/Index" role="button">Cancel</a>
                </div>
            </div>
        </form>
    </div>
</div>
