@page
@model ReservationApp.Pages.Admin.Categories.IndexModel
@{
    ViewData["Title"] = "Categories";
}

<h2 class="text-center mb-4"><i class="bi bi-tags"></i> Restaurant Categories</h2>

<div class="mb-3">
    <a class="btn btn-primary" href="/Admin/Categories/Create"><i class="bi bi-plus-lg"></i> New Category</a>
</div>

@if (!Model.Categories.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-tags display-4"></i>
        <p class="lead mt-3">No categories yet.</p>
    </div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <tr>
            <th>Name</th>
            <th>Restaurants Using It</th>
            <th>Action</th>
        </tr>

        @foreach (var category in Model.Categories)
        {
            var count = Model.RestaurantCountByCategory.GetValueOrDefault(category.CategoryId, 0);
            <tr>
                <td>@category.Name</td>
                <td><span class="badge bg-secondary">@count</span></td>
                <td>
                    <div class="button-container">
                        <a class="action-btn edit-delete-btn" href="/Admin/Categories/Edit?id=@category.CategoryId"><i class="bi bi-pencil-fill"></i> Edit</a>
                        <a class="action-btn edit-delete-btn delete" href="/Admin/Categories/Delete/@category.CategoryId"><i class="bi bi-trash-fill"></i> Delete</a>
                    </div>
                </td>
            </tr>
        }
    </table>
}
