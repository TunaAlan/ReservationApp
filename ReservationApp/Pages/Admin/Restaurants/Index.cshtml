@page
@model ReservationApp.Pages.Admin.Restaurants.IndexModel
@{
    ViewData["Wide"] = true;
    string CategoryBadgeClass(string category) => category switch
    {
        "Seafood" => "bg-info text-dark",
        "Fine Dining" => "bg-dark",
        "Fast Food" => "bg-warning text-dark",
        "Japanese" => "bg-danger",
        "Italian" => "bg-success",
        "Cafe" => "bg-secondary",
        "Steakhouse" => "bg-primary",
        "Bistro" => "bg-light text-dark border",
        _ => "bg-secondary"
    };
}

<div class="page-toolbar">
    <div>
        <h2 class="page-toolbar-title"><i class="bi bi-building"></i> Restaurant Management</h2>
        <p class="page-toolbar-subtitle">Manage restaurants, categories and cities.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-primary" href="/Admin/Restaurants/Create"><i class="bi bi-plus-lg"></i> New Restaurant</a>
        <a class="btn btn-outline-secondary" href="/Admin/Categories/Index"><i class="bi bi-tags"></i> Manage Categories</a>
        <a class="btn btn-outline-secondary" href="/Admin/Cities/Index"><i class="bi bi-geo-alt"></i> Manage Cities</a>
    </div>
</div>

<partial name="_RestaurantFilterBar" model="Model.Filter" />

@if (!Model.Restaurants.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-search display-4"></i>
        <p class="lead mt-3">No restaurants match your search.</p>
    </div>
}
else
{
<div class="table-shell">
<table class="table align-middle">
     <tr>
        <th>Restaurant Id</th>
        <th>Name</th>
        <th>Category</th>
        <th>Capacity</th>
        <th>Booked Today</th>
        <th>Image</th>
    </tr>

    @foreach (var restaurant in Model.Restaurants)
    {
         <tr class="row-clickable" data-bs-toggle="modal" data-bs-target="#details-@restaurant.RestaurantId" title="View details">
            <td>@restaurant.RestaurantId</td>
            <td>@restaurant.Name</td>
            <td><span class="badge @CategoryBadgeClass(restaurant.Category?.Name ?? "")">@restaurant.Category?.Name</span></td>
            <td>@restaurant.Capacity <span class="text-muted">(@restaurant.Tables.Count tables)</span></td>
            <td>
                @{
                    var booked = Model.BookedTodayByRestaurant.GetValueOrDefault(restaurant.RestaurantId, 0);
                    var isFull = restaurant.Tables.Count > 0 && booked >= restaurant.Tables.Count;
                }
                <span class="badge @(isFull ? "bg-danger" : "bg-success")" title="Tables occupied at today's busiest moment">
                    @booked / @restaurant.Tables.Count tables
                </span>
            </td>
            <td>
               @if (restaurant.CoverImageFileName != null)
               {
                   <img src="/Restaurant_Img/@restaurant.CoverImageFileName" alt="@restaurant.Name" class="restaurant-img-thumb" />
               }
               else
               {
                   <div class="restaurant-img-thumb no-image-placeholder"><i class="bi bi-image"></i></div>
               }
            </td>
        </tr>
    }

</table>
</div>
}

@foreach (var restaurant in Model.Restaurants)
{
    <div class="modal fade" id="details-@restaurant.RestaurantId" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-shop"></i> @restaurant.Name</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <partial name="_RestaurantGallery" model="restaurant" />
                    </div>
                    <partial name="_RestaurantDetailList" model="restaurant" />
                    <partial name="_WeeklyOccupancyStrip" model="Model.WeeklyOccupancyByRestaurant.GetValueOrDefault(restaurant.RestaurantId, new())" />
                    <p class="text-muted mt-3 mb-0">
                        <i class="bi bi-person-badge"></i> Owner:
                        @if (restaurant.OwnerUser != null)
                        {
                            @restaurant.OwnerUser.Email
                        }
                        else
                        {
                            <span class="fst-italic">Unassigned</span>
                        }
                    </p>
                    <p class="text-muted mt-1 mb-0"><i class="bi bi-calendar-check"></i> Added on @restaurant.CreatedAt.ToString("MM/dd/yyyy")</p>
                </div>
                <div class="modal-footer">
                    <a class="action-btn outline-btn" href="/Admin/Restaurants/Tables/Index?restaurantId=@restaurant.RestaurantId"><i class="bi bi-grid-3x3-gap"></i> Manage Tables</a>
                    <a class="action-btn outline-btn" href="/Admin/Restaurants/Settings/Index?restaurantId=@restaurant.RestaurantId"><i class="bi bi-sliders"></i> Settings</a>
                    <a class="action-btn edit-delete-btn" href="/Admin/Restaurants/Edit?id=@restaurant.RestaurantId"><i class="bi bi-pencil-fill"></i> Edit</a>
                    <a class="action-btn edit-delete-btn delete" href="/Admin/Restaurants/Delete/@restaurant.RestaurantId"><i class="bi bi-trash-fill"></i> Delete</a>
                    <button type="button" class="action-btn close-btn" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/restaurant-filter.js" asp-append-version="true"></script>
}
