@page
@model ReservationApp.Pages.Admin.Restaurants.Tables.EditModel
@{
    ViewData["Title"] = "Edit Table";
}

<div class="row">
    <div class="col-md-6 mx-auto rounded border p-3">
        <h2 class="text-center mb-5"><i class="bi bi-grid-3x3-gap"></i> Edit Table — @Model.Restaurant?.Name</h2>

        @if (Model.errorMessage.Length > 0)
        {
            <div class="alert alert-danger" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i> @Model.errorMessage
            </div>
        }
        else if (Model.successMessage.Length > 0)
        {
            <div class="alert alert-success" role="alert">
                <i class="bi bi-check-circle-fill"></i> @Model.successMessage
            </div>
        }

        <form method="post">
            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Label</label>
                <div class="col-sm-8">
                    <input class="form-control" asp-for="RestaurantTable.Label" />
                    <span asp-validation-for="RestaurantTable.Label" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Seats</label>
                <div class="col-sm-8">
                    <input class="form-control" type="number" asp-for="RestaurantTable.SeatCount" />
                    <span asp-validation-for="RestaurantTable.SeatCount" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="offset-sm-4 col-sm-4 d-grid">
                    <button type="submit" class="btn btn-primary">Submit</button>
                </div>
                <div class="col-sm-4 d-grid">
                    <a class="btn btn-outline-primary" href="/Admin/Restaurants/Tables/Index?restaurantId=@Model.RestaurantTable.RestaurantId" role="button">Cancel</a>
                </div>
            </div>
        </form>
    </div>
</div>
