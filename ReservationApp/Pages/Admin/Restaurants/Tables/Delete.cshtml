@page "{id:int}"
@model ReservationApp.Pages.Admin.Restaurants.Tables.DeleteModel
@{
    ViewData["Title"] = "Delete Table";
}

<h2 class="text-center mb-4"><i class="bi bi-grid-3x3-gap"></i> Delete Table</h2>

@if (!string.IsNullOrEmpty(Model.errorMessage))
{
    <div class="alert alert-danger d-flex justify-content-between align-items-center flex-wrap gap-2" role="alert">
        <span><i class="bi bi-exclamation-triangle-fill"></i> @Model.errorMessage</span>
        <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#reservations-modal">
            <i class="bi bi-list-check"></i> View Reservations
        </button>
    </div>
}
else if (Model.ActiveReservationsUsingIt > 0)
{
    <div class="alert alert-danger d-flex justify-content-between align-items-center flex-wrap gap-2" role="alert">
        <span><i class="bi bi-exclamation-triangle-fill"></i> This table has @Model.ActiveReservationsUsingIt upcoming reservation(s) and cannot be deleted.</span>
        <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#reservations-modal">
            <i class="bi bi-list-check"></i> View Reservations
        </button>
    </div>
}
else
{
    <div class="alert alert-warning">
        Are you sure you want to delete table <strong>@Model.RestaurantTable?.Label</strong> (@Model.RestaurantTable?.SeatCount seats) at <strong>@Model.Restaurant?.Name</strong>? This action cannot be undone.
    </div>
}

<form method="post" class="d-flex justify-content-end gap-2 mt-3">
    <a href="/Admin/Restaurants/Tables/Index?restaurantId=@Model.RestaurantTable?.RestaurantId" class="action-btn close-btn">Cancel</a>
    <button type="submit" class="action-btn edit-delete-btn delete" disabled="@(Model.ActiveReservationsUsingIt > 0)">Delete</button>
</form>

@if (Model.ActiveReservations.Any())
{
    <div class="modal fade" id="reservations-modal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-list-check"></i> Upcoming Reservations — Table @Model.RestaurantTable?.Label</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <table class="table table-striped align-middle mb-0">
                        <tr>
                            <th>Date &amp; Time</th>
                            <th>Guests</th>
                            <th>Customer</th>
                        </tr>
                        @foreach (var reservation in Model.ActiveReservations)
                        {
                            <tr>
                                <td>@reservation.ReservationDate.ToString("MM/dd/yyyy h:mm tt")</td>
                                <td>@reservation.NumberOfPeople</td>
                                <td>@(reservation.User?.Email ?? "—")</td>
                            </tr>
                        }
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="action-btn close-btn" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
}
