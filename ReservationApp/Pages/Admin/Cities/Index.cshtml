@page
@model ReservationApp.Pages.Admin.Cities.IndexModel
@{
    ViewData["Title"] = "Cities";
}

<h2 class="text-center mb-4"><i class="bi bi-geo-alt"></i> Cities</h2>

<div class="mb-3">
    <a class="btn btn-primary" href="/Admin/Cities/Create"><i class="bi bi-plus-lg"></i> New City</a>
</div>

@if (!Model.Cities.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-geo-alt display-4"></i>
        <p class="lead mt-3">No cities yet.</p>
    </div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <tr>
            <th>Name</th>
            <th>Restaurants Using It</th>
            <th>Action</th>
        </tr>

        @foreach (var city in Model.Cities)
        {
            var count = Model.RestaurantCountByCity.GetValueOrDefault(city.CityId, 0);
            <tr>
                <td>@city.Name</td>
                <td><span class="badge bg-secondary">@count</span></td>
                <td>
                    <div class="button-container">
                        <a class="action-btn edit-delete-btn" href="/Admin/Cities/Edit?id=@city.CityId"><i class="bi bi-pencil-fill"></i> Edit</a>
                        <a class="action-btn edit-delete-btn delete" href="/Admin/Cities/Delete/@city.CityId"><i class="bi bi-trash-fill"></i> Delete</a>
                    </div>
                </td>
            </tr>
        }
    </table>
}
