@page "{id:int}"
@model ReservationApp.Pages.Client.Reservations.DeleteReservationModel
@{
    ViewData["Title"] = "Cancel Reservation";
}

<h2 class="text-center mb-4"><i class="bi bi-calendar-x"></i> Cancel Reservation</h2>

@if (!string.IsNullOrEmpty(Model.errorMessage))
{
    <div class="alert alert-danger" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i> @Model.errorMessage
    </div>
}

<div class="alert alert-warning">
    Are you sure you want to cancel this reservation for
    <strong>@Model.Reservation?.ReservationDate.ToString("MM/dd/yyyy h:mm tt")</strong>
    (@Model.Reservation?.NumberOfPeople people)? This action cannot be undone.
</div>

<form method="post" asp-page-handler="Delete" class="d-flex justify-content-end gap-2 mt-3">
    <a asp-page="./MyReservations" class="action-btn close-btn">Back</a>
    <button type="submit" class="action-btn edit-delete-btn delete">Cancel Reservation</button>
</form>
