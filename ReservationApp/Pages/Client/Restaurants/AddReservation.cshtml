@page
@using ReservationApp.Models
@model ReservationApp.Pages.Client.Restaurants.AddReservationModel
@{
    ViewData["Title"] = "Add Reservation";
    var settings = Model.Restaurant?.Settings;
    var minDate = settings != null && !settings.AcceptSameDayReservations ? DateTime.Today.AddDays(1) : DateTime.Today;
    var maxDate = DateTime.Today.AddDays(settings?.MaxAdvanceBookingDays ?? 6);
    var maxPartySize = settings?.MaxGuestsPerReservation is int cap
        ? Math.Min(cap, Model.Restaurant?.Capacity ?? cap)
        : Model.Restaurant?.Capacity;
}

<h2 class="text-center mb-4"><i class="bi bi-calendar-plus"></i> Add Reservation</h2>

@if (!string.IsNullOrEmpty(Model.errorMessage))
{
    <div class="alert alert-danger" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i> @Model.errorMessage
    </div>
}

<div class="container mt-4">
    <div class="row g-4">
        <div class="col-md-5">
            @if (Model.Restaurant != null)
            {
                <partial name="_RestaurantGallery" model="Model.Restaurant" />
            }
        </div>

        <div class="col-md-7">
            @if (Model.Restaurant != null)
            {
                <div class="card border-light shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title">@Model.Restaurant.Name</h5>
                        <partial name="_RestaurantDetailList" model="Model.Restaurant" />
                    </div>
                </div>
            }
        </div>
    </div>

    @if (Model.UpcomingAvailability.Any())
    {
        <div class="row mt-4">
            <div class="col-md-12">
                <div class="card border-light shadow-sm">
                    <div class="card-body">
                        <h6 class="card-subtitle text-muted mb-3"><i class="bi bi-calendar-week"></i> Availability — Next 7 Days</h6>
                        <div class="availability-strip">
                            @foreach (var day in Model.UpcomingAvailability)
                            {
                                <div class="availability-day @(!day.HasAvailability ? "is-full" : "")">
                                    <div class="availability-day-name">@day.Date.ToString("ddd")</div>
                                    <div class="availability-day-date">@day.Date.ToString("MMM d")</div>
                                    <div class="availability-day-count">
                                        @if (!day.HasAvailability)
                                        {
                                            <span><i class="bi bi-x-circle-fill"></i> Full</span>
                                        }
                                        else
                                        {
                                            <span><i class="bi bi-check-circle-fill"></i> Available</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card border-light shadow-sm">
                <div class="card-body">
                    <p class="text-muted mb-3">
                        <i class="bi bi-person-circle"></i> Booking as <strong>@Model.LoggedInUserName</strong>
                    </p>

                    <h6 class="card-subtitle text-muted mb-3"><i class="bi bi-search"></i> Find a Time</h6>
                    <form method="get" class="row g-3 align-items-end" novalidate>
                        <input type="hidden" name="id" value="@Model.Restaurant?.RestaurantId" />
                        <div class="col-sm-4">
                            <label for="date" class="form-label">Date</label>
                            <input id="date" name="date" class="form-control" type="date" value="@Model.Reservation.ReservationDate.ToString("yyyy-MM-dd")" min="@minDate.ToString("yyyy-MM-dd")" max="@maxDate.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-sm-4">
                            <label for="partySize" class="form-label">Number of People</label>
                            <input id="partySize" name="partySize" class="form-control" type="number" min="1" max="@maxPartySize" value="@Model.Reservation.NumberOfPeople" />
                            @if (settings?.MaxGuestsPerReservation is int guestCap)
                            {
                                <div class="form-text">Max @guestCap guests per reservation.</div>
                            }
                        </div>
                        <div class="col-sm-4 d-grid">
                            <button type="submit" class="btn btn-outline-primary"><i class="bi bi-search"></i> Check Availability</button>
                        </div>
                    </form>

                    <hr class="my-4" />

                    <h6 class="card-subtitle text-muted mb-3">
                        <i class="bi bi-clock"></i>
                        Available times on @Model.Reservation.ReservationDate.ToString("MMM d") for @Model.Reservation.NumberOfPeople @(Model.Reservation.NumberOfPeople == 1 ? "guest" : "guests")
                        <span class="text-muted">(table held for @Model.Restaurant?.Settings?.ReservationDurationMinutes minutes)</span>
                    </h6>

                    @if (!Model.SlotsForSelectedDate.Any())
                    {
                        <p class="text-muted mb-0"><i class="bi bi-clock-history"></i> No more bookable times today. Pick another date above.</p>
                    }
                    else if (!Model.SlotsForSelectedDate.Any(s => s.Available))
                    {
                        <p class="text-muted mb-0"><i class="bi bi-x-circle"></i> No tables available for that date and party size. Try a different date or fewer guests.</p>
                    }
                    else
                    {
                        <form method="post" novalidate>
                            <input type="hidden" asp-for="Reservation.ReservationDate" />
                            <input type="hidden" asp-for="Reservation.NumberOfPeople" />
                            @if (settings?.AllowReservationNotes == true)
                            {
                                <div class="mb-3">
                                    <label asp-for="Reservation.Notes" class="form-label">Note for the restaurant (optional)</label>
                                    <textarea asp-for="Reservation.Notes" class="form-control" rows="2" maxlength="500" placeholder="Allergies, special occasion, seating preference..."></textarea>
                                </div>
                            }
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var slot in Model.SlotsForSelectedDate)
                                {
                                    var label = slot.Time.ToString(@"hh\:mm");
                                    var slotId = label.Replace(":", "");
                                    if (slot.Available)
                                    {
                                        <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#confirm-@slotId">@label</button>

                                        <div class="modal fade" id="confirm-@slotId" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title"><i class="bi bi-calendar-check"></i> Confirm Reservation</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <dl class="detail-list mb-0">
                                                            <div class="detail-row">
                                                                <dt><span class="detail-icon"><i class="bi bi-shop"></i></span> Restaurant</dt>
                                                                <dd>@Model.Restaurant?.Name</dd>
                                                            </div>
                                                            <div class="detail-row">
                                                                <dt><span class="detail-icon"><i class="bi bi-calendar-event"></i></span> Date</dt>
                                                                <dd>@Model.Reservation.ReservationDate.ToString("MMM d, yyyy")</dd>
                                                            </div>
                                                            <div class="detail-row">
                                                                <dt><span class="detail-icon"><i class="bi bi-clock"></i></span> Time</dt>
                                                                <dd>@label</dd>
                                                            </div>
                                                            <div class="detail-row detail-row-last">
                                                                <dt><span class="detail-icon"><i class="bi bi-people"></i></span> Guests</dt>
                                                                <dd>@Model.Reservation.NumberOfPeople</dd>
                                                            </div>
                                                        </dl>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="action-btn close-btn" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" name="SelectedTime" value="@label" class="action-btn primary-btn"><i class="bi bi-check-circle"></i> Confirm Reservation</button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-outline-secondary" disabled>@label</button>
                                    }
                                }
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
