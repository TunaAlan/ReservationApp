@page
@using ReservationApp.Models
@model ReservationApp.Pages.Client.Restaurants.AddReservationModel
@{
    ViewData["Title"] = "Add Reservation";
}

<h2 class="text-center mb-4"><i class="bi bi-calendar-plus"></i> Add Reservation</h2>

@if (!string.IsNullOrEmpty(Model.errorMessage))
{
    <div class="alert alert-danger" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i> @Model.errorMessage
    </div>
}

<div class="container mt-4">
    <div class="row g-4">
        <div class="col-md-5">
            @if (Model.Restaurant != null)
            {
                <img src="/Restaurant_Img/@Model.Restaurant.ImageFileName" alt="@Model.Restaurant.Name" class="img-fluid rounded shadow-sm restaurant-card-img" style="height: 260px;" />
            }
        </div>

        <div class="col-md-7">
            @if (Model.Restaurant != null)
            {
                <div class="card border-light shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title">@Model.Restaurant.Name</h5>
                        <partial name="_RestaurantDetailList" model="Model.Restaurant" />
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card border-light shadow-sm">
                <div class="card-body">
                    <p class="text-muted mb-3">
                        <i class="bi bi-person-circle"></i> Booking as <strong>@Model.LoggedInUserName</strong>
                    </p>

                    <form method="post">
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <label asp-for="Reservation.ReservationDate" class="form-label">Reservation Date</label>
                                <input asp-for="Reservation.ReservationDate" class="form-control" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                <span asp-validation-for="Reservation.ReservationDate" class="text-danger"></span>
                            </div>

                            <div class="col-sm-6">
                                <label asp-for="Reservation.NumberOfPeople" class="form-label">Number of People</label>
                                <input asp-for="Reservation.NumberOfPeople" class="form-control" type="number" min="1" />
                                <span asp-validation-for="Reservation.NumberOfPeople" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-group mt-4">
                            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-check-circle"></i> Confirm Reservation</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
