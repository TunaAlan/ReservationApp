@page
@model ReservationApp.Pages.Client.Restaurants.RestaurantListModel
@{
}

<h2 class="text-center mb-4"><i class="bi bi-shop-window"></i> Restaurants</h2>

<partial name="_RestaurantFilterBar" model="Model.Filter" />

@if (!Model.Restaurants.Any())
{
    var isFiltered = !string.IsNullOrWhiteSpace(Model.Search) || Model.CategoryId.HasValue || Model.CityId.HasValue;
    <div class="text-center text-muted py-5">
        <i class="bi @(isFiltered ? "bi-search" : "bi-shop") display-4"></i>
        <p class="lead mt-3">@(isFiltered ? "No restaurants match your search." : "No restaurants available yet. Check back soon.")</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var restaurant in Model.Restaurants)
        {
            <div class="col-sm-6 col-lg-4">
                <div class="card h-100 shadow-sm position-relative">
                    @if (Model.FullTodayRestaurantIds.Contains(restaurant.RestaurantId))
                    {
                        <span class="full-today-badge">
                            <i class="bi bi-x-circle-fill"></i> Capacity Full Today
                        </span>
                    }
                    @if (restaurant.CoverImageFileName != null)
                    {
                        <img src="/Restaurant_Img/@restaurant.CoverImageFileName" class="card-img-top restaurant-card-img" alt="@restaurant.Name" />
                    }
                    else
                    {
                        <div class="card-img-top restaurant-card-img no-image-placeholder"><i class="bi bi-image display-4"></i></div>
                    }
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@restaurant.Name</h5>
                        <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                            <span class="badge bg-secondary">@restaurant.Category?.Name</span>
                            <span class="location-pill"><i class="bi bi-geo-alt-fill"></i> @restaurant.City?.Name</span>
                        </div>
                        <p class="card-text text-muted mb-3">
                            @restaurant.District — @restaurant.Address
                        </p>
                        <div class="mt-auto d-flex gap-2">
                            <button type="button" class="btn btn-outline-secondary flex-fill" data-bs-toggle="modal" data-bs-target="#details-@restaurant.RestaurantId">
                                <i class="bi bi-info-circle"></i> Details
                            </button>
                            <a class="btn btn-primary flex-fill" href="/Client/Restaurants/AddReservation?id=@restaurant.RestaurantId">
                                <i class="bi bi-calendar-plus"></i> Reserve
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal fade" id="details-@restaurant.RestaurantId" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title"><i class="bi bi-shop"></i> @restaurant.Name</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div class="mb-3">
                                <partial name="_RestaurantGallery" model="restaurant" />
                            </div>
                            <partial name="_RestaurantDetailList" model="restaurant" />
                            <partial name="_WeeklyOccupancyStrip" model="Model.WeeklyOccupancyByRestaurant.GetValueOrDefault(restaurant.RestaurantId, new())" />
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="action-btn close-btn" data-bs-dismiss="modal">Close</button>
                            <a class="action-btn primary-btn" href="/Client/Restaurants/AddReservation?id=@restaurant.RestaurantId">
                                <i class="bi bi-calendar-plus"></i> Reserve Now
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <script src="~/js/restaurant-filter.js" asp-append-version="true"></script>
}